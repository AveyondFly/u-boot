{
  "schema_version": 1,
  "soc": "rk3566",
  "id": "powkiddy-x35h",
  "description": "Powkiddy X35H / RK817 / red and green charging LEDs",
  "defconfig": "rk3566_powkiddy_x35h_defconfig",
  "dtb_mode": "embedded",
  "dtb_path": "/rk3566-charge.dtb",
  "required_kconfig": [
    "IRQ",
    "RK8XX_PWRKEY",
    "PMIC_RK8XX",
    "POWER_FG_RK817",
    "LED_GPIO",
    "IO_DOMAIN"
  ],
  "inputs": {
    "linux_dtb": "linux-vendor.dtb",
    "idb": "idb-original.bin",
    "uboot": "uboot-original.img"
  },
  "overlays": [
    "charge.dtso"
  ],
  "checks": [
    {
      "node": "/i2c@fdd40000/pmic@20/charger",
      "property": "charge_red_gpio",
      "gpio_controller": "/pinctrl/gpio@fe770000",
      "pin": 12,
      "flags": 0
    },
    {
      "node": "/i2c@fdd40000/pmic@20/charger",
      "property": "charge_green_gpio",
      "gpio_controller": "/pinctrl/gpio@fe770000",
      "pin": 13,
      "flags": 0
    },
    {
      "node": "/i2c@fdd40000/pmic@20/charger",
      "property": "charge_yellow_gpio",
      "gpio_controller": "/pinctrl/gpio@fe770000",
      "pin": 14,
      "flags": 0
    }
  ],
  "output_checks": [
    {
      "node": "/",
      "property": "model",
      "string": "Powkiddy x35h"
    },
    {
      "node": "/i2c@fdd40000/pmic@20/battery",
      "property": "design_capacity",
      "cells": [
        2718
      ]
    },
    {
      "node": "/i2c@fdd40000/pmic@20/battery",
      "property": "design_qmax",
      "cells": [
        2990
      ]
    },
    {
      "node": "/i2c@fdd40000/pmic@20/battery",
      "property": "bat_res",
      "cells": [
        94
      ]
    },
    {
      "node": "/charge-animation",
      "property": "rockchip,uboot-exit-charge-auto",
      "cells": [
        0
      ]
    },
    {
      "node": "/charge-animation",
      "property": "rockchip,charged-led-min-soc",
      "cells": [
        90
      ]
    }
  ],
  "control_dtb": {
    "name": "rk3566-powkiddy-x35h",
    "power_init": "board-dtb",
    "mmc_reference": "vendor-boot",
    "mmc_reference_sha256": {
      "spl": "9679fe2a45776f35494f95ccbf57831f94c54cc90b3766a2f7371e169ac928fb",
      "uboot": "9679fe2a45776f35494f95ccbf57831f94c54cc90b3766a2f7371e169ac928fb"
    },
    "checks": [
      {
        "node": "/",
        "property": "model",
        "string": "Powkiddy x35h"
      },
      {
        "node": "/chosen",
        "property": "stdout-path",
        "string": "/serial@fe660000"
      },
      {
        "node": "/sdhci@fe310000",
        "property": "bus-width",
        "cells": [
          8
        ]
      },
      {
        "node": "/sdhci@fe310000",
        "property": "max-frequency",
        "cells": [
          200000000
        ]
      },
      {
        "node": "/dwmmc@fe2b0000",
        "property": "max-frequency",
        "cells": [
          150000000
        ]
      }
    ]
  }
}
